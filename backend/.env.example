# Kopieren nach .env und bei Bedarf anpassen
PORT=8000
# Nur lokal erreichbar (Single-User-App ohne Anmeldung). Nicht auf 0.0.0.0 ändern!
HOST=127.0.0.1
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# HTTPS (lokal z. B. mit mkcert: mkcert localhost 127.0.0.1)
USE_HTTPS=false
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem
