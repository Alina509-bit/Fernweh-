{
  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-net --allow-env --allow-read --allow-write main.ts",
    "start": "deno run --env-file=.env --allow-net --allow-env --allow-read --allow-write main.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "check": "deno check main.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.7.0",
    "@zod/zod": "jsr:@zod/zod@^4.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0"
  },
  "fmt": {
    "lineWidth": 100
  }
}
